
kernel @add<N,K>() {

    place i16 i, i16 j in [0:5, 0:5] {
        i16[100] a
    }

    dataflow i16 i, i16 j in [0:5, 0:5] {
        multistream<i16> red = reduce_stream(0, 0) {
            algorithm = grid,
            op = CL_SUM,
            pipelined = true
        }
    }

    compute i16 i, i16 j in [0:5, 0:5] {
        a[0] = 1
        for i32 test1 in [0:999] {
            a[0] = 100
            await reduce(a, red)
        }
    }
}