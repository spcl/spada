
kernel @add<N,K>() {

    place i16 i, i16 j in [0:5, 0:5] {
        i16[100] a
    }

    dataflow i16 i, i16 j in [0:5, 0:5] {
        multistream<i16> red = reduce_stream(0, 0) {
            algorithm = grid,
            op = CL_SUM,
            pipelined = false
        }
        multistream<i16> red2 = reduce_stream(0, 4) {
            algorithm = grid,
            op = CL_SUM,
            pipelined = false
        }
        multistream<i16> red3 = reduce_stream(4, 0) {
            algorithm = snake,
            op = CL_SUM,
            pipelined = false
        }
    }

    compute i16 i, i16 j in [0:5, 0:5] {
        a[0] = 1
        for i32 test1 in [0:999] {
            a[0] = 100
            await reduce(a, red)
            for i32 test2 in [0:25] {
                await reduce(a, red2)
                await reduce(a, red)
                for i32 test3 in [0:30] {
                    for i32 test4 in [0:35] {
                        for i32 test5 in [0:40] {
                            await reduce(a, red3)
                        }
                    }
                } 
            }
        }
    }
}