/**
 * Simple 1D scalar chain reduction
 * N is the number of PEs in the first row.
 * Root is 0,0
 * Receiving and sending share channel 0, so every middle PE's router switches between the
 * two configurations. See tests/csl_runtime/pending_scalar_reduce_1d.sh
 *
 * WARNING: this sample does not compile yet, for a reason unrelated to routing. `await
 * receive(rcv_val, westwards)` targets a scalar, and scalars in place blocks get no DSD, so
 * `emit_copy` falls through to a plain assignment and emits `rcv_val = westwards;` -- a reference
 * to an undeclared identifier. Scalar receives need to lower either to a data task or to a
 * one-element DSD before this runs. The routing itself lowers correctly.
 **/
 kernel @reduce<N>(stream<f32, 1>[N] readonly inp, stream<f32, 1> writeonly out) {

    // Shared Place
    place u16 i, u16 j in [N-1:N, 0:1] {
        f32 local
    }

    // Shared Dataflow
    dataflow u16 i, u16 j in [0:N, 0:1] {
        stream<f32> westwards = relative_stream(-1, 0) {
            hops = [(-1, 0)],
            channel = 0
        }
    }

    // Start
    compute u16 i, u16 j in [N-1:N, 0:1] {
        await receive(local, inp[i])
        await send(local, westwards)
    }

    // Middle
    place u16 i, u16 j in [1:N-1, 0:1] {
        f32 local
        f32 rcv_val
    }
    compute u16 i, u16 j in [1:N-1, 0:1] {
        await receive(local, inp[i])
        await receive(rcv_val, westwards)
        rcv_val = rcv_val + local
        await send(rcv_val, westwards)
    }
    // End
    place u16 i, u16 j in [0:1, 0:1] {
        f32 local
        f32 rcv_val
    }
    compute u16 i, u16 j in [0:1, 0:1] {
        await receive(local, inp[i])
        await receive(rcv_val, westwards)
        rcv_val = rcv_val + local
        await send(rcv_val, out)
    }
}