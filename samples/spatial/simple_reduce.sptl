
kernel @add<N,K>() {

    place i16 i, i16 j in [0:5, 0:5] {
        i16[1] a
    }

    dataflow i16 i, i16 j in [0:5, 0:5] {
        multistream<i16> red = reduce(0, 0) {
            graph = snake,
            op = S_SUM,
            pipelined = true
        }
    }

    compute i16 i, i16 j in [0:5, 0:5] {
        a[0] = 1
        await reduce(a, red)
    }
}