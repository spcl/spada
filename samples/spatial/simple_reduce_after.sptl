
kernel @add<N,K>() {

    place i16 i, i16 j in [0:1, 0:2] {
        i16[1] a;
    }

    dataflow i16 i, i16 j in [0:1, 0:2] {
        stream<i16> reduce0 = relative_stream(0, 1) {
            hops = [(0, 1)],
            channel = auto
        }
    }

    compute i16 i, i16 j in [0, 0] {
        a[0] = 1;
        await foreach i32 reduce_runner, i16 reduce_receive in [0:1], receive(reduce0) {
          a[reduce_runner] = a[reduce_runner] + reduce_receive;
        }
    }

    compute i16 i, i16 j in [0, 1] {
        a[0] = 1;
        await send(a, reduce0);
    }
}