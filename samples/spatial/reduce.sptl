
kernel @add<N,K>(stream<f32>[N, N] readonly a_in, stream<f32> writeonly out) {

    place u16 i, u16 j in [0:N, 0:N] {
        f32[K] a;
    }

    dataflow i16 i, i16 j in [0:N, 0:N] {
        multistream<f32> red = reduce(0, 0) {
            hops = auto,
            channel = {0, 1},
            op = sum
        }
    }

    compute i16 i, i16 j in [1:N, 1:N] {
        await receive(a, a_in)
        await reduce(a, red)
    }

    compute i16 i, i16 j in [0, 0] {
        await receive(a, a_in)
        await reduce(a, red)
        await send(a, out)
    }

    compute i16 i, i16 j in [0, 1:N] {
        await receive(a, a_in)
        await reduce(a, red)
    }

    compute i16 i, i16 j in [1:N, 0] {
        await receive(a, a_in)
        await reduce(a, red)
    }

}