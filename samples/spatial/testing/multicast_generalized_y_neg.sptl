/**
 * Generalized y-axis negative-direction multicast.
 * Sender at PE (0, RE-1) receives values from the host, writes its copy to
 * out[0, RE-1], and multicasts NORTH via range [-RS:-RE] to PEs (0,0)…(0,RE-RS-1).
 * PEs (0,RE-RS)…(0,RE-2) are relay-only when RS > 1.
 *
 * Parameters:
 *   RS – positive magnitude of range start  (offset of first receiver = -RS)
 *   RE – positive magnitude of range end    (exclusive; RE > RS)
 *
 * Expected: OUT_out[0, RE-1, 0] == inp[0, 0, 0]  (sender)
 *           OUT_out[0, k, 0]    == inp[0, 0, 0]  for k in 0..RE-RS-1 (receivers)
 *           OUT_out[0, k, 0]    unwritten         for k in RE-RS..RE-2 (relay PEs)
 **/
kernel @multicast_generalized_y_neg<RS, RE>(
    stream<f32, 2>[1, 1]   readonly  inp,
    stream<f32, 2>[1, RE] writeonly out
) {
    place u16 i, u16 j in [0:1, 0:RE] {
        f32[2] val
    }

    dataflow u16 i, u16 j in [0:1, 0:RE] {
        stream<f32> s = relative_stream(0, [-RS:-RE]) {
            hops = auto,
            channel = 0
        }
    }

    // Sender: last PE in y; load from host, write own output, multicast northward.
    compute u16 i, u16 j in [0:1, RE-1:RE] {
        await receive(val, inp[i, 0])
        await send(val, out[i, j])
        await send(val, s)
    }

    // Receivers: first RE-RS PEs in y.
    compute u16 i, u16 j in [0:1, 0:RE-RS] {
        await receive(val, s)
        await send(val, out[i, j])
    }
}
