/**
 * Generalized y-axis multicast: PE (0,0) receives values from the host,
 * writes its copy to out[0,0], and multicasts to PEs (0,START) … (0,STOP-1).
 * PEs (0,1)…(0,START-1) are relay-only when START > 1.
 * Every receiving PE writes its copy to out[0,j].
 *
 * Expected: OUT_out[0, 0, 0]   == inp[0, 0, 0]  (sender)
 *           OUT_out[0, k, 0]   == inp[0, 0, 0]  for k in START..STOP-1 (receivers)
 *           OUT_out[0, k, 0]   unwritten         for k in 1..START-1  (relay PEs)
 **/
kernel @multicast_generalized_y<START, STOP>(
    stream<f32, 2>[1, 1]    readonly  inp,
    stream<f32, 2>[1, STOP] writeonly out
) {
    place u16 i, u16 j in [0:1, 0:STOP] {
        f32[2] val
    }

    dataflow u16 i, u16 j in [0:1, 0:STOP] {
        stream<f32> s = relative_stream(0, [START:STOP]) {
            hops = auto,
            channel = 0
        }
    }

    // Sender: load from host, write own output, then multicast downstream.
    compute u16 i, u16 j in [0:1, 0:1] {
        await receive(val, inp[i, j])
        await send(val, out[i, j])
        await send(val, s)
    }

    // Receivers: collect broadcast value and write to output.
    compute u16 i, u16 j in [0:1, START:STOP] {
        await receive(val, s)
        await send(val, out[i, j])
    }
}
