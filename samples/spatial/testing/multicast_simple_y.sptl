/**
 * Simple y-axis multicast: PE (0,0) receives one value from the host,
 * outputs it locally, and multicasts it to PEs (0,1) ... (0,K-1).
 * Every PE writes its copy to the output, so no shifted index is needed.
 *
 * Input:  stream<f32,1>[1,1] — one f32 delivered to PE (0,0).
 * Output: stream<f32,1>[1,K] — K f32 values, one per PE.
 *
 * Expected: OUT_out[0, k, 0] == inp[0, 0, 0]  for k in 0..K-1.
 **/
kernel @multicast_simple_y<K>(
    stream<f32, 1>[1, 1] readonly  inp,
    stream<f32, 1>[1, K] writeonly out
) {
    place u16 i, u16 j in [0:1, 0:K] {
        f32 val
    }

    dataflow u16 i, u16 j in [0:1, 0:K] {
        stream<f32> s = relative_stream(0, [1:K]) {
            hops = auto,
            channel = 0
        }
    }

    // Sender: load from host, write to output, then multicast downstream.
    compute u16 i, u16 j in [0:1, 0:1] {
        await receive(val, inp[i, j])
        await send(val, out[i, j])
        await send(val, s)
    }

    // Receivers: collect the broadcast value and write it to the output.
    compute u16 i, u16 j in [0:1, 1:K] {
        await receive(val, s)
        await send(val, out[i, j])
    }
}
