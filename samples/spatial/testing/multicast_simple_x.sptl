/**
 * Simple x-axis multicast: PE (0,0) receives two values from the host,
 * outputs it locally, and multicasts it to PEs (1,0) ... (K-1,0).
 * Every PE writes its copy to the output.
 *
 * Expected: OUT_out[k, 0, 0] == inp[0, 0, 0]  for k in 0..K-1.
 **/
kernel @multicast_simple_x<K>(
    stream<f32, 2>[1, 1] readonly  inp,
    stream<f32, 2>[K, 1] writeonly out
) {
    place u16 i, u16 j in [0:K, 0:1] {
        f32[2] val
    }

    dataflow u16 i, u16 j in [0:K, 0:1] {
        stream<f32> s = relative_stream([1:K], 0) {
            hops = auto,
            channel = 0
        }
    }

    // Sender: load from host, write to output, then multicast downstream.
    compute u16 i, u16 j in [0:1, 0:1] {
        await receive(val, inp[i, j])
        await send(val, out[i, j])
        await send(val, s)
    }

    // Receivers: collect the broadcast value and write it to the output.
    compute u16 i, u16 j in [1:K, 0:1] {
        await receive(val, s)
        await send(val, out[i, j])
    }
}
