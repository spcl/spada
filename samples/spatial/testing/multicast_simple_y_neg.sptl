/**
 * Simple y-axis negative-direction multicast: PE (0,K-1) receives values from the
 * host, outputs it locally, and multicasts it NORTH to PEs (0,K-2) … (0,0).
 * Every PE writes its copy to the output.
 *
 * Expected: OUT_out[0, k, 0] == inp[0, 0, 0]  for k in 0..K-1.
 **/
kernel @multicast_simple_y_neg<K>(
    stream<f32, 2>[1, 1] readonly  inp,
    stream<f32, 2>[1, K] writeonly out
) {
    place u16 i, u16 j in [0:1, 0:K] {
        f32[2] val
    }

    dataflow u16 i, u16 j in [0:1, 0:K] {
        stream<f32> s = relative_stream(0, [-1:-(K)]) {
            hops = auto,
            channel = 0
        }
    }

    // Sender (last row): load from host, write to output, then multicast northward.
    compute u16 i, u16 j in [0:1, K-1:K] {
        await receive(val, inp[i, j-(K-1)])
        await send(val, out[i, j])
        await send(val, s)
    }

    // Receivers: collect the broadcast value and write it to the output.
    compute u16 i, u16 j in [0:1, 0:K-1] {
        await receive(val, s)
        await send(val, out[i, j])
    }
}
